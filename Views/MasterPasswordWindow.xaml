<Window x:Class="PasswordGenerator.MasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PasswordGenerator"
        Title="{x:Static p:Resources.MasterPwd_WindowTitle}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubHeaderText" Grid.Row="1" TextWrapping="Wrap"
                   Margin="0,0,0,16" Foreground="Gray"/>

        <TextBlock Grid.Row="2" Text="{x:Static p:Resources.MasterPwd_Label}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordBox1" Grid.Row="3" Padding="4" Margin="0,0,0,12"
                     KeyDown="PasswordBox_KeyDown"/>

        <StackPanel x:Name="ConfirmPanel" Grid.Row="4" Visibility="Collapsed">
            <TextBlock Text="{x:Static p:Resources.MasterPwd_ConfirmLabel}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox2" Padding="4" Margin="0,0,0,12"
                         KeyDown="PasswordBox_KeyDown"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Grid.Row="6" Foreground="Red" TextWrapping="Wrap"
                   VerticalAlignment="Top" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="{x:Static p:Resources.MasterPwd_CloseButton}" Width="130" Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="OkButton" Content="{x:Static p:Resources.PwdPrompt_OkButton}" Width="80" IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
