<Window x:Class="PasswordGenerator.AboutProgram"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordGenerator"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="AboutProgram" Height="360" Width="591">
    <Grid Background="#99D6D6D6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek (Row 0) -->
        <Label x:Name="AboutHeaderLabel" Grid.Row="0" Content="About" Margin="10,5,0,0" FontFamily="Segoe UI" FontSize="24"/>

        <!-- Zawartość główna w ramce (Row 1) -->
        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Rectangle Fill="#FFD2D2D2" Stroke="#FFB1B1B1" RadiusX="3.29" RadiusY="3.29"/>

            <StackPanel Margin="10">
                <!-- Główny opis -->
                <TextBlock x:Name="AboutDescriptionTextBlock" TextWrapping="Wrap" FontSize="14" />

                <!-- Przycisk z ikoną GitHub ustawiony po prawej stronie -->
                <Button x:Name="GitHubButton" Click="GitHubButton_Click"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        ToolTip="Open GitHub profile"
                        HorizontalAlignment="Right"
                        Margin="0,5,5,5"
                        Width="44" Height="44">
                    <Image Source="pack://application:,,,/Assets/github.png" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Button>

                <!-- Dodatkowy tekst na dole -->
                <TextBlock x:Name="AboutExtraTextBlock" TextWrapping="Wrap" FontSize="14" Opacity="0.5" />
            </StackPanel>
        </Grid>

        <!-- Stopka (Row 2) -->
        <Label x:Name="AboutFooterLabel" Grid.Row="2" Content="Version 1.0.0 | © 2026 Qwaterek" Margin="10,0,0,5" FontFamily="Segoe UI" FontSize="12"/>
    </Grid>
</Window>