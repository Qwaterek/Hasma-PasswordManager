<Window x:Class="PasswordGenerator.CreateAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordGenerator"
        mc:Ignorable="d"
        Title="CreateAccount" Height="420" Width="800"
        ResizeMode="CanMinimize">

    <Grid Background="#99D6D6D6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nagłówek -->
        <Label x:Name="CreateHeaderLabel" Grid.Row="0" Content="Add New Account" Margin="10,10,0,0" FontSize="24"/>

        <!-- Szara ramka i pola -->
        <Grid Grid.Row="1" Margin="10,10,10,0">
            <Rectangle Fill="#FFD2D2D2" Stroke="#FFB1B1B1" RadiusX="3.29" RadiusY="3.29"/>

            <Canvas>
                <Label x:Name="LabelUrl" Content="URL:" Canvas.Left="15" Canvas.Top="20" Height="26"/>
                <TextBox x:Name="TextBox_URL" Canvas.Left="148" Canvas.Top="24" Width="464" TextChanged="TextBox_TextChanged_1"/>

                <Label x:Name="LabelUsername" Content="Username:" Canvas.Left="15" Canvas.Top="80" Height="26"/>
                <TextBox x:Name="TextBox_UserName" Canvas.Left="148" Canvas.Top="84" Width="464" TextChanged="TextBox_TextChanged_2"/>

                <Label x:Name="LabelEmail" Content="Email:" Canvas.Left="15" Canvas.Top="120" Height="26"/>
                <TextBox x:Name="TextBox_Email" Canvas.Left="148" Canvas.Top="124" Width="464" TextChanged="TextBox_TextChanged_3"/>

                <Label x:Name="LabelPassword" Content="Password:" Canvas.Left="15" Canvas.Top="160" Height="26"/>
                <!-- Pole zwężone z 464 do 425, aby zrobić miejsce na przycisk -->
                <TextBox x:Name="TextBox_Password" Canvas.Left="148" Canvas.Top="164" Width="425" TextChanged="TextBox_TextChanged_4"/>

                <!-- Przycisk ponownego generowania hasła -->
                <Button x:Name="RefreshPasswordButton" 
                        Content="🔄" 
                        ToolTip="Generate new password" 
                        Canvas.Left="578" Canvas.Top="162" 
                        Width="27" Height="22" 
                        IsEnabled="{Binding IsChecked, ElementName=GeneratePassword}" 
                        Click="RefreshPasswordButton_Click"/>

                <!-- CheckBox wyzwalający generowanie -->
                <CheckBox x:Name="GeneratePassword" 
                          Content="Generate password" 
                          Canvas.Left="17" Canvas.Top="199" 
                          HorizontalAlignment="Left" VerticalAlignment="Center" Width="144"
                          Checked="GeneratePassword_Changed"
                          Unchecked="GeneratePassword_Changed"
                          ToolTip="Zaznacz, aby losowo wygenerować nowe hasło"/>

                <!-- Grupa opcji wygaszana automatycznie przez IsEnabled -->
                <StackPanel Orientation="Horizontal" 
                            Canvas.Left="36" Canvas.Top="226" 
                            IsEnabled="{Binding IsChecked, ElementName=GeneratePassword}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="197">

                    <RadioButton x:Name="Weak" Content="Weak" Margin="0,0,15,0" Checked="RadioButton_Checked" ToolTip="Weak password contains only letters or digits"/>
                    <RadioButton x:Name="Medium" Content="Medium" Margin="0,0,15,0" Checked="RadioButton_Checked" ToolTip="Medium password contains a mix of letters and digits"/>
                    <RadioButton x:Name="Strong" Content="Strong" Checked="RadioButton_Checked" ToolTip="Strong password contains a mix of letters, digits and special characters" Width="56"/>

                </StackPanel>
                <StackPanel Orientation="Horizontal" 
            Canvas.Left="409" Canvas.Top="226" 
            IsEnabled="{Binding IsChecked, ElementName=GeneratePassword}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="196">
                    <CheckBox x:Name="CreateFastPassword" Content="Use quick password generator" Checked="RadioButton_Checked" Width="195" ToolTip="Use a quick password generator which is weaker but easier to remember"/>

                </StackPanel>


                <!-- Napis informujący o dacie ostatniej zmiany -->
                <TextBlock x:Name="LastModifiedTextBlock" 
                           Text="Password was last modified on:" 
                           Canvas.Left="10" Canvas.Top="246" 
                           Foreground="#FF555555" 
                           FontStyle="Italic" 
                           Visibility="Collapsed"/>
            </Canvas>
        </Grid>

        <!-- Przyciski na dole -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
            <Button x:Name="DeleteButton" Content="{x:Static local:Resources.DeleteAccount}" Height="25" Width="82" Margin="0,0,10,0" Visibility="Collapsed" Click="DeleteButton_Click"/>
            <Button x:Name="Back" Content="{x:Static local:Resources.Cancel}" Height="25" Width="82" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="{x:Static local:Resources.Save}" Height="25" Width="82" Click="Button_Click" IsDefault="True" ToolTip="Zapisz konto do bazy danych"/>
        </StackPanel>
    </Grid>
</Window>