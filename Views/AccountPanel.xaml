<Window x:Class="PasswordGenerator.AccountPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordGenerator"
        mc:Ignorable="d"
        Title="AccountPanel" Height="522" Width="837"
        ResizeMode="CanMinimize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="G_Accounts_Panel" 
                  Grid.Row="0" 
                  Margin="0,0,0,10"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  MouseDoubleClick="G_Accounts_Panel_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="IconColumn" Header="Icon" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="16" Height="16" 
                                   Source="{Binding FaviconUrl}" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="UrlColumn" Header="URL / Service" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn x:Name="UserColumn" Header="User" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn x:Name="EmailColumn" Header="Email" Binding="{Binding Email}" Width="*"/>

                <!-- Kolumna Hasło z kontrolką maskującą jak w MainWindow -->
                <DataGridTemplateColumn x:Name="PasswordColumn" Header="Password" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <local:MaskedPasswordControl />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Height="25">
                <TextBox x:Name="SearchTextBox" 
                         Padding="4,0,0,0" 
                         VerticalContentAlignment="Center" 
                         BorderBrush="#FFABADB3"/>

                <TextBlock x:Name="SearchPlaceholderTextBlock" Text="Search..." 
                           Foreground="Gray" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Margin="6,0,0,0" 
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Button x:Name="AddAccountButton" Content="{x:Static local:Resources.AccountPanel_AddButton}" 
                    Grid.Column="2" 
                    Height="25" 
                    Width="115" 
                    Click="Button_Click"
                    ToolTip="Add a new account to the database"/>
        </Grid>
    </Grid>
</Window>