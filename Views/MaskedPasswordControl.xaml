<UserControl x:Class="PasswordGenerator.MaskedPasswordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TextBlock x:Name="PasswordTextBlock" 
               Text="{Binding MaskedPassword}" 
               VerticalAlignment="Center" 
               HorizontalAlignment="Left" 
               Margin="5,0,0,0"
               Background="Transparent"
               PreviewMouseRightButtonDown="Password_PreviewMouseRightButtonDown"
               PreviewMouseRightButtonUp="Password_PreviewMouseRightButtonUp"
               MouseLeave="Password_MouseLeave"/>
</UserControl>
